/* CSS Basics */

body {
    background-color: lightblue;
    font-family: Arial, sans-serif;
    text-align: center;
}

h1 {
    color: darkblue;
    font-size: 40px;
}

p {
    color: black;
    font-size: 20px;
}

.box {
    width: 300px;
    height: 150px;
    background-color: white;
    margin: 30px auto;
    padding: 20px;
    border: 2px solid blue;
    border-radius: 10px;
}

button {
    background-color: blue;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
}

button:hover {
    background-color: darkblue;
}
